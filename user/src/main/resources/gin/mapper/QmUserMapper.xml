<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="gin.mapper.QmUserMapper">

    <resultMap id="BaseResultMap" type="gin.entity.QmUser">
            <id property="id" column="id" />
            <result property="wxOpenid" column="wx_openid" />
            <result property="phone" column="phone" />
            <result property="wxName" column="wx_name" />
            <result property="avatarUrl" column="avatar_url" />
            <result property="role" column="role" />
            <result property="isActive" column="is_active" />
            <result property="createdAt" column="created_at" />
            <result property="updatedAt" column="updated_at" />
    </resultMap>

    <sql id="Base_Column_List">
        id,wx_openid,phone,wx_name,avatar_url,role,
        is_active,created_at,updated_at
    </sql>

    <select id="selectUserWithAuth" resultType="gin.model.QmUser.QmUserAuthVO">
        SELECT qm_user.id as userId,phone,wx_name,wx_openid,qm_auth.name, qm_auth.voice_message
        FROM qm_user left join qm_user_auth on qm_user.id = qm_user_auth.user_id
        left join qm_auth on qm_user_auth.auth_id = qm_auth.id
        <where>
            <if test="phone!=null and phone !=''">
                OR  qm_user.phone = #{phone}
            </if>
            <if test="userId!=null and userId !=''">
            OR  qm_user.id = #{userId}
            </if>
            <if test="(phone == null or phone == '') and (userId == null or userId == '')">
                OR 1 = 0
            </if>
        </where>
    </select>
</mapper>
